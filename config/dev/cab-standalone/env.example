# Copy to .env and fill in values before starting

# --- System ---
USER_ID=1000
USER_GID=1000
CONFIG_PATH=./
SPRING_PROFILES_ACTIVE=docker

# --- Railway brain URL ---
# Must be reachable FROM THE BROWSER (not from inside Docker)
# Local dev:   http://localhost:5001
# Deployment:  http://<SERVER_PUBLIC_IP>:5001
VITE_RAILWAY_SIMU=http://localhost:5001

# --- Other simulations (leave empty if not used) ---
VITE_POWERGRID_SIMU=
VITE_ATM_SIMU=
VITE_COGNITIVE_TOKEN=

# --- RL Agent (recommendation service) ---
# Local Docker: http://host.docker.internal:5001/recommendations
# Server:       http://railway-brain:5001/recommendations
RL_AGENT_API_URL=http://host.docker.internal:5001/recommendations
RL_AGENT_API_TOKEN=

# --- Auth ---
AUTH_DISABLED=true
